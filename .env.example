# Copy to .env for `node scripts/local-server.js`. Leave a provider blank to skip it.
# Do not commit real keys. Set the same names in the Vercel project settings.

OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides. Defaults are the cheap grounded models.
# OPENAI_MODEL=gpt-4.1-mini
# PERPLEXITY_MODEL=perplexity/sonar
# GEMINI_MODEL=gemini-2.5-flash-lite
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_WEB_SEARCH_TOOL=web_search_20250305

# Optional. Uncomment GEMINI_THINKING_BUDGET=0 to disable Gemini 2.5 thinking when the model allows it.
# GEMINI_THINKING_BUDGET=0

# PROVIDER_TIMEOUT_MS=20000
# Perplexity prompts run one at a time. The budget keeps that sequence under the 60s function cap.
# PERPLEXITY_BUDGET_MS=50000
# PERPLEXITY_PROMPT_DELAY_MS=1100
# PERPLEXITY_429_RETRIES=2
# SCORE_PROMPT_COUNT=4
# SCORE_MAX_OUTPUT_TOKENS=600
# SCORE_CACHE_TTL_SEC=86400
# RATE_LIMIT_MAX=8
# RATE_LIMIT_WINDOW_SEC=3600

# Paid reports. Production and preview already have SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY (an sb_secret_ key, server only).
# Paste supabase/schema.sql once into the Supabase SQL editor before the first paid report.
# Do not prefix the secret key with NEXT_PUBLIC_.
# SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Paid reports. A read-only restricted key: Checkout Sessions, Customers, Subscriptions.
# STRIPE_RESTRICTED_KEY=
# RESEND_API_KEY=
# REPORT_FROM_EMAIL=reports@ai-mentions.com
# CRON_SECRET=
# PUBLIC_BASE_URL=https://ai-mentions.com
# CRON_BUDGET_MS=65000
