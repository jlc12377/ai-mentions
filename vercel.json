{
  "functions": {
    "api/score.js": {
      "maxDuration": 60
    },
    "api/report.js": {
      "maxDuration": 60
    },
    "api/cron/reports.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/reports",
      "schedule": "0 14 * * *"
    }
  ],
  "rewrites": [
    { "source": "/report", "destination": "/report.html" },
    { "source": "/r/:token", "destination": "/api/r?token=:token" }
  ]
}
